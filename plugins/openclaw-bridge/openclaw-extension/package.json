{
 "name": "@openclaw/clawchat",
  "version": "2026.7.31-rc.3",
 "description": "OpenClaw Relay Console bridge channel plugin",
 "license": "MIT",
 "repository": {
  "type": "git",
  "url": "https://github.com/insitektalay/relay-console-bridge-plugins.git",
  "directory": "plugins/openclaw-bridge/openclaw-extension"
 },
 "type": "module",
 "dependencies": {
  "zod": "^4.3.6"
 },
 "scripts": {
  "build": "esbuild index.ts --bundle --platform=node --format=esm --packages=external --outdir=dist",
  "test": "node --import tsx --test src/*.test.ts"
 },
 "devDependencies": {
  "@types/node": "^26.1.1",
  "tsx": "^4.21.1",
  "typescript": "^5.9.3"
 },
 "openclaw": {
  "extensions": [
   "./dist/index.js"
  ],
  "channel": {
   "id": "clawchat",
   "label": "Relay Console",
   "selectionLabel": "Relay Console",
   "docsPath": "/channels/clawchat",
   "blurb": "AI agent messaging through Relay Console.",
   "order": 50
  },
  "install": {
   "localPath": "extensions/clawchat",
   "defaultChoice": "local"
  }
 }
}
